[Unit]
Description=KevinTech Telegram Bot + License API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/kevintech-bot
EnvironmentFile=/opt/kevintech-bot/.env
ExecStart=/usr/bin/node /opt/kevintech-bot/index.js
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
